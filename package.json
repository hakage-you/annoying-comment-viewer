  "scripts": {
    "start": "electron-forge start",
    "dev": "chcp 65001 > nul && rimraf public && run-p --race _start:*",
    "_start:tsc": "tsc -w -p tsconfig.main.json",
    "_start:webpack": "cross-env NODE_ENV=\"development\" webpack",
    "_start:electron": "wait-on ./public/index.html && cross-env NODE_ENV=\"development\" electron .",
    "dev:main": "cross-env NODE_ENV=\"development\" npm run dev",
    "dev:ui": "cross-env DEBUG_UI=true npm run dev",
    "dev:all": "cross-env NODE_ENV=\"development\" DEBUG_UI=true npm run dev",
    "build": "cross-env NODE_ENV=\"production\" NODE_OPTIONS=\"--max-old-space-size=4096\" webpack --progress",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "tar": "^7.5.11",
    "@tootallnate/once": "^3.0.1",
    "tmp": "^0.2.4"
